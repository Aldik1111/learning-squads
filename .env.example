# Copy to .env.local. Use a dedicated Learning Squads Supabase project.
# Enable Auth > Anonymous Sign-Ins and apply supabase/migrations in order.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Publishable/legacy anon key only. Never use service_role or secret keys here.
# The application needs no administrative database credential.
# No AI or payment provider is configured.

# Server-only Google Calendar organizer OAuth (never NEXT_PUBLIC, never commit values).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Optional OPEN access requires explicit organizer consent and the
# meetings.space.settings Google scope. Leave false until authorized.
GOOGLE_MEET_OPEN_ACCESS=false
