# Copy to .env.local. Use a dedicated Learning Squads Supabase project.
# Enable Auth > Anonymous Sign-Ins and apply supabase/migrations in order.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Publishable/legacy anon key only. Never use service_role or secret keys here.
# The application needs no administrative database credential.
# No AI or payment provider is configured.
